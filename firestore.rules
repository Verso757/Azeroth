rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admin check: checks if user document has role 'admin' OR if email matches bootstrap
    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'yaquimdm@gmail.com'
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['name', 'email', 'role']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.email is string && data.email.matches('^.+@.+$') &&
               data.role in ['admin', 'user'];
      }

      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && (
        incoming().role == 'user' || request.auth.token.email == 'yaquimdm@gmail.com'
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name'])) ||
        isAdmin()
      );
    }

    // 2. Areas Collection
    match /areas/{areaId} {
      function isValidArea(data) {
        return data.keys().hasAll(['name']) &&
               data.name is string && data.name.size() > 0 && data.name.size() <= 100;
      }

      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidArea(incoming());
    }

    // 3. Problems Collection
    match /problems/{problemId} {
      function isValidProblem(data) {
        return data.keys().hasAll(['title', 'areaId', 'priority', 'status', 'userId', 'occurrenceDate']) &&
               data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
               data.areaId is string && exists(/databases/$(database)/documents/areas/$(data.areaId)) &&
               data.priority in ['high', 'medium', 'low'] &&
               data.status in ['open', 'in_progress', 'closed'] &&
               data.userId == request.auth.uid &&
               data.occurrenceDate is string; // Simplified for rule but real check would be better
      }

      allow read: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      
      allow create: if isSignedIn() && isValidProblem(incoming());

      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'occurrenceDate', 'recurrenceCount'])) ||
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['recurrenceCount']))
      );
      
      allow delete: if isAdmin();

      // Recurrences subcollection
      match /occurrences/{occId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
      }
    }
  }
}
